# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Evolution API v2 Configuration (WhatsApp transport)
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=shrot47
WEBHOOK_SECRET=your-webhook-secret-token

# Database & Storage
DB_PATH=schrot47_bot.db

# Safety & Circuit Breakers (Defaults: Fail-Closed)
PRODUCTION_ENABLED=false
OUTBOUND_ENABLED=false
KILL_SWITCH=true

# Optional Legacy Telegram Configuration (if running dual-stack)
TELEGRAM_TOKEN=your-telegram-bot-token
